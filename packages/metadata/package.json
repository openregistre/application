{
    "name": "@openregistre/metadata",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "tsc --build",
        "typecheck": "tsc --noEmit",
        "prepack": "tsc --build"
    },
    "devDependencies": {
        "@types/node": "25.5.0",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "drizzle-orm": "0.45.1",
        "nanoid": "5.1.7",
        "postgres": "3.4.8",
        "valibot": "1.2.0"
    },
    "files": [
        "build"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "exports": {
        "./orm": {
            "types": "./build/orm/index.d.ts",
            "default": "./build/orm/index.js"
        },
        "./routes": {
            "types": "./build/routes/index.d.ts",
            "default": "./build/routes/index.js"
        },
        "./schemas": {
            "types": "./build/schemas/index.d.ts",
            "default": "./build/schemas/index.js"
        },
        "./utilities": {
            "types": "./build/utilities/index.d.ts",
            "default": "./build/utilities/index.js"
        }
    }
}